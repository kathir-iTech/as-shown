YOUCAM_API_KEY=
YOUCAM_API_BASE_URL=https://yce-api-01.makeupar.com
# Enable only after verifying free bonus units and disabling automatic purchases.
YOUCAM_ALLOW_GENERATION=false
YOUCAM_PREPAID_ONLY_CONFIRMED=false
# Generate at least 32 random bytes. Never prefix secrets with NEXT_PUBLIC_.
ASSHOWN_TOKEN_SECRET=
# Stop live requests when remaining free units reach this reserve.
ASSHOWN_UNIT_RESERVE=100
# Free Redis only. Never enable automatic upgrades or a paid fallback.
KV_REST_API_URL=
KV_REST_API_TOKEN=
# Persistent aggregate reservation cap. Must be between 2 and 800.
ASSHOWN_LIFETIME_UNIT_CAP=800
